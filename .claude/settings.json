{
  "plansDirectory": ".claude/plans",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "codeload.github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "galaxy.ansible.com",
        "*.galaxy.ansible.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.ansible"
      ],
      "denyWrite": [
        "~/.ssh"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "ansible-playbook *",
      "docker *",
      "git clone *",
      "git fetch *",
      "git ls-remote *",
      "git pull *",
      "git submodule *"
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ghostty +list-actions:*)",
      "Bash(ghostty +list-keybinds:*)",
      "Bash(ghostty +show-config:*)",
      "Bash(ghostty +list-themes:*)",
      "Bash(ghostty +list-colors:*)",
      "Bash(ghostty +list-fonts:*)",
      "Bash(ghostty +validate-config:*)",
      "Bash(ghostty +version:*)",
      "Bash(ansible-playbook *--check*)",
      "Bash(ansible-playbook *--syntax-check*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:release-assets.githubusercontent.com)",
      "WebFetch(domain:api.github.com)"
    ],
    "ask": ["Bash(dangerouslyDisableSandbox:true)"],
    "deny": ["WebFetch(domain:analytics.brew.sh)"]
  }
}
