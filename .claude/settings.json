{
  "plansDirectory": ".claude/plans",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "galaxy.ansible.com",
        "*.galaxy.ansible.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.ansible"
      ],
      "denyWrite": [
        "~/.ssh"
      ]
    },
    "excludedCommands": [
      "docker *",
      "git fetch *",
      "git pull *",
      "git submodule *"
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ghostty +list-actions:*)",
      "Bash(ghostty +list-keybinds:*)",
      "Bash(ghostty +show-config:*)",
      "Bash(ghostty +list-themes:*)",
      "Bash(ghostty +list-colors:*)",
      "Bash(ghostty +list-fonts:*)",
      "Bash(ghostty +validate-config:*)",
      "Bash(ghostty +version:*)"
    ],
    "ask": ["Bash(dangerouslyDisableSandbox:true)"]
  }
}
