# Matches the Dracula look from alacritty/alacritty.toml + dracula.toml.
theme = Dracula+

font-family = Hack Nerd Font Mono
font-size = 14

background-opacity = 0.9
background-blur = true

# Ghostty's default is 2px per side, which leaves text nearly flush against the
# window edge. window-padding-balance spreads the leftover pixels from a
# non-exact cell fit evenly instead of piling them on the right/bottom edges.
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true

scrollback-limit = 10000000

# ssh-terminfo copies Ghostty's xterm-ghostty terminfo entry to remote hosts on first
# connect (via `infocmp | ssh … tic -x -`), so remote ncurses apps and powerlevel10k
# render correctly instead of falling back to a wrong capability set (doubled echo,
# mangled prompt). ssh-env forwards COLORTERM / TERM_PROGRAM(_VERSION) so remotes
# detect truecolor. Listed alongside the defaults (cursor,sudo,title) since setting
# this key replaces them rather than adding to them.
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# Alacritty sends ESC CR on Shift+Return so terminal apps can tell it apart
# from plain Enter.
keybind = shift+enter=text:\x1b\r

# Split resizing: Ghostty's default super+ctrl+<arrow> moves the divider by only
# 10px per press, which takes a lot of presses to rebalance a split. Same keys,
# 50px step (~5-6 rows / ~7 columns at font-size 14). super+ctrl+enter
# (equalize_splits) is left at its default, so overshooting is easy to undo.
keybind = super+ctrl+up=resize_split:up,50
keybind = super+ctrl+down=resize_split:down,50
keybind = super+ctrl+left=resize_split:left,50
keybind = super+ctrl+right=resize_split:right,50

# macos-option-as-alt is intentionally left unset: on the Czech layout its
# default is already "false", so Option keeps composing diacritics/digits
# instead of being swallowed as Alt.

# Tab switching, Czech layout: the number row lives under Option (opt+2 = "2"),
# so cmd+opt+<key> is the natural press for "go to tab N" — but Ghostty only
# binds cmd+<physical digit> by default. physical digit_N codes are
# layout-independent; the second block below matches the same keys by the
# character they actually produce on Czech (+ ě š č ř ž ý á í é for 1-0),
# since Ghostty matches Unicode triggers against the *unmodified* codepoint,
# never the Option-shifted one. Both forms are added so cmd+<key> and
# cmd+opt+<key> both work; physical-key matches always win over Unicode ones,
# so there's no conflict.
keybind = super+alt+digit_1=goto_tab:1
keybind = super+alt+digit_2=goto_tab:2
keybind = super+alt+digit_3=goto_tab:3
keybind = super+alt+digit_4=goto_tab:4
keybind = super+alt+digit_5=goto_tab:5
keybind = super+alt+digit_6=goto_tab:6
keybind = super+alt+digit_7=goto_tab:7
keybind = super+alt+digit_8=goto_tab:8
keybind = super+alt+digit_9=last_tab

keybind = super++=goto_tab:1
keybind = super+alt++=goto_tab:1
keybind = super+ě=goto_tab:2
keybind = super+alt+ě=goto_tab:2
keybind = super+š=goto_tab:3
keybind = super+alt+š=goto_tab:3
keybind = super+č=goto_tab:4
keybind = super+alt+č=goto_tab:4
keybind = super+ř=goto_tab:5
keybind = super+alt+ř=goto_tab:5
keybind = super+ž=goto_tab:6
keybind = super+alt+ž=goto_tab:6
keybind = super+ý=goto_tab:7
keybind = super+alt+ý=goto_tab:7
keybind = super+á=goto_tab:8
keybind = super+alt+á=goto_tab:8
keybind = super+í=last_tab
keybind = super+alt+í=last_tab
